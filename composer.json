{
    "name": "korriganmaster/lite-collection",
    "description": "PHP SQLlite collection",
    "type": "library",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Korriganmaster\\LiteCollection\\": "src/"
        }
    },
    "authors": [
        {
            "name": "KorriganMaster",
            "email": "lionheart.shadow@gmail.com"
        }
    ],
    "minimum-stability": "stable",
    "require": {
        "php": ">=7.3",
        "ext-sqlite3": "*"
    },
    "scripts": {
        "test": "./vendor/bin/phpunit ./test",
        "phpstan": "./vendor/bin/phpstan analyse src --level=max",
        "csfixer": "./vendor/bin/php-cs-fixer fix src"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6",
        "phpstan/phpstan": "^1.12",
        "friendsofphp/php-cs-fixer": "^3.4"
    }
}
